{
  "name": "nf-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.23.5",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run arch && pnpm run check:adr && pnpm run check:features",
    "typecheck": "tsc && tsc -p e2e && tsc -p spikes/s5-nf-metro && pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --test-timeout=30000",
    "arch": "depcruise . --config .dependency-cruiser.cjs --output-type err-long",
    "dev": "pnpm --filter @nf-builder/web dev",
    "build": "pnpm --filter @nf-builder/web build",
    "preview": "pnpm --filter @nf-builder/web preview",
    "test:e2e": "node scripts/run-playwright.ts",
    "smoke": "node scripts/smoke.ts",
    "spike:s5": "node spikes/s5-nf-metro/serve.ts",
    "check:adr": "node scripts/check-adrs.ts",
    "check:features": "node scripts/check-features.ts",
    "check:budget": "node scripts/check-bundle-budget.ts",
    "check:hosts": "node scripts/check-hosts.ts",
    "corpus:fetch": "node tools/corpus/src/cli.ts",
    "gen:grammar": "node scripts/gen-grammar.ts",
    "gen:catalogue": "node tools/spec-extract/src/cli.ts",
    "gen:palette": "node scripts/gen-palette.ts",
    "corpus:lint": "node tools/corpus/src/lint-cli.ts",
    "test:corpus": "vitest run --config vitest.corpus.config.ts",
    "nextflow": "node tools/oracle/src/nextflow-cli.ts",
    "oracle": "node tools/oracle/src/cli.ts",
    "registry:snapshot": "node tools/registry-snapshot/src/cli.ts",
    "check:registry": "node scripts/check-registry-snapshot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "antlr-ng": "1.0.10",
    "dependency-cruiser": "18.8.0",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
