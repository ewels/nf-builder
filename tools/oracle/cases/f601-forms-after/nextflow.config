// F-601 forms fixture: each placement rule of the config commands.
manifest {
    description = 'Greets and shouts'
    nextflowVersion = '>=26.10.6'
    name = 'greeter'
}

docker.runOptions = '-u 1000'

process {
    withName: GREET {
        cpus = 1
        memory = 4.GB
    }
    memory = 2.GB
    time = 1.h
    errorStrategy = 'retry'
    maxRetries = 3
    resourceLimits = [cpus: 4, memory: 8.GB, time: 2.h]
    withLabel: big_mem {
        memory = 8.GB
    }
}

wave {
    build.repository = 'quay.io/example/wave'
}

profiles {
    test {
        params.count = 1
        process.cpus = 2
    }
    'gpu-test' {
        process.memory = 16.GB
    }
}

conda {
    channels = ['conda-forge', 'bioconda']
}

executor {
    queueSize = 10
    pollInterval = 5.s
}

env {
    GREETING_STYLE = 'loud'
}

params {
    ratio = 0.5
    loud = true
}

cleanup = true
