// F-103 fixture. Source: nextflow-io/nextflow v26.10.7 docs/config.mdx#L287-L317, plus the nf-core `publishDir` and
// `ext.args` shapes (closures, maps, `when`).
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    withName: 'FASTQC' {
        when = { meta.id != params.skip_sample }
        ext.args = '--quiet'
        memory = { 6.GB * task.attempt }
        errorStrategy = { task.exitStatus in [143, 137] ? 'retry' : 'finish' }
    }
    withName: 'NFCORE_.*:ALIGN' { ext.when = false }
}

workflow.onComplete = {
    println "Pipeline complete"
    println "Command line: $workflow.commandLine"
}
workflow.onError = {
    println "Error: something went wrong"
}
workflow.output.mode = params.publish_mode

env {
    FOO = 'bar'
}
params {
    max_cpus = 64
    nested {
        deep = 1
    }
}
manifest {
    name = 'x/y'
    contributors = [
        [name: 'A', affiliation: 'B'],
        [name: 'C', affiliation: 'D']
    ]
}
nextflow.enable.configProcessNamesValidation = false
