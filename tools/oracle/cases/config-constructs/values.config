// F-103 fixture. Expression and statement kinds from nextflow-io/nextflow v26.10.7 docs/reference/syntax.mdx, as
// config values and closure bodies.
params.integers = [1, 0x1F, 1_000, 10L, 7i]
params.floats = [1.5e3, 2.0d, 3.5f]
params.words = [true, false, null]
params.strings = ['single', "double", '''triple
single''', """triple
double""", /slashy/]
params.escapes = 'tab\there \\ \'quoted\' é'
params.size = 8.GB
params.time = 1.h
params.gstring = "${params.outdir}/x_$params.name.id"
params.list = [1, 2, 3,]
params.map = [name: 'x', (params.key): 1, 'quoted': 2, 'a-b': 3]
params.empty = [:]
params.nested = [[a: 1], [b: [c: 2]]]
params.safe = params.a?.b
params.spread = [[a: 1]]*.a
params.index = params.list[0]
params.call = env('HOME')
params.date = new java.util.Date().format('yyyy')
params.ops = 1 + 2 * 3 - 4 / 2 % 3 ** 2
params.logic = !params.a && params.b || params.c
params.compare = 1 < 2 && 2 <= 3 && 3 > 2 && 3 >= 2 && 1 == 1 && 1 != 2 && 1 <=> 2
params.bits = 1 & 2 | 3 ^ 4 << 1 >> 1 >>> 1
params.range = [1..3, 1..<3]
params.regex = 'abc' =~ /a/ && 'abc' ==~ /abc/
params.membership = 1 in [1, 2] && 3 !in [1, 2]
params.cast = params.x as Integer
params.instance = params.x instanceof List && params.y !instanceof List
params.ternary = params.a ? params.b : params.c ? params.d : params.e
params.elvis = params.a ?: params.b ?: 'c'
params.paren = (params.a + 1) * 2
params.unary = [-1, +1, ~1, !true]
params.map_call = [1, 2].collect { it * 2 }
process.ext.version = { task.attempt }
process.ext.args = { meta -> meta.id ? "--id ${meta.id}" : '' }
process.ext.args2 = { String a, int b = 1 -> a * b }
process.ext.pre = {
    def v = 1
    def (a, b) = [1, 2]
    String s = 'x'
    int n = 2
    (a, b) = [b, a]
    v += 1
    assert v == 2 : 'wrong'
    try {
        v
    }
    catch( IOException | IllegalStateException e ) {
        throw e
    }
    catch( Exception e ) {
        return v
    }
    if( v > 1 ) println 'big'
    else if( v < 0 ) { println 'small' }
    println v
    ;
    return v
}
