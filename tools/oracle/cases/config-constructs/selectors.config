// F-103 fixture. Source: nextflow-io/nextflow v26.10.7 docs/config.mdx#L185-L286, plus `agent` selectors and an unknown
// selector kind (ConfigParser.g4 configSelector accepts any identifier).
process {
    cpus = 4
    withLabel: big_mem {
        cpus = 16
        memory = 64.GB
        queue = 'long'
    }
    withName: hello {
        cpus = 4
        memory = 8.GB
    }
    withName: 'PARENT:hello' { cpus = 2 }
    withLabel: 'hello|bye' { cpus = 2 }
    withLabel: '!hello' { cpus = 4 }
    withName: '!align.*' { queue = 'long' }
    withName: '.*:PARENT:hello' { cpus = 8 }
    withName: 'aloha:bye' { cpus = 32 }
    withFoo: x { cpus = 1 }
}

agent {
    withName: helper { cpus = 2 }
}
