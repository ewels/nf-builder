// F-103 fixture. Source: nextflow-io/nextflow v26.10.7 docs/config.mdx#L319-L357 and #L158-L167, with an include in a
// profile and mixed dot and block syntax.
profiles {
    standard {
        process.executor = 'local'
    }

    cluster {
        process.executor = 'sge'
        process.queue = 'long'
        process.memory = '10GB'
    }

    cloud {
        process.executor = 'cirrus'
        process.container = 'cbcrg/imagex'
        docker.enabled = true
    }

    test {
        includeConfig 'conf/test.config'
        params.input = "${projectDir}/test/input.txt"
    }
}
