// F-601 (FI-06): eleven selectors, each setting its own ext key so the run shows which processes it matched.
process {
    withName: GREET { ext.simple = 1 }
    withName: '.*:GREET' { ext.dotstar = 1 }
    withName: 'GREETING:GREET' { ext.fq = 1 }
    withName: '!TWICE.*' { ext.notTwice = 1 }
    withLabel: big_mem { ext.label = 1 }
    withName: 'SHOUT|TWICE_A' { ext.either = 1 }
    withName: TWICE { ext.declared = 1 }
    withName: TWICE_A { ext.alias = 1 }
    withLabel: '!big_mem' { ext.notLabel = 1 }
    withName: '.*:SHOUT' { ext.missingPrefix = 1 }
    withName: NOPE { ext.nope = 1 }
}
