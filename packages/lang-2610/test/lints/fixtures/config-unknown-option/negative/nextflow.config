// F-601 (FI-03): names the run-time validator never checks, and names that are valid.
params.name = 'x'
env.GREETING_STYLE = 'loud'
workDir = 'work'
poolSize = 4
cloudcache.path = 's3://bucket/cache'

manifest {
    description = 'Greets and shouts'
}

process {
    cpus = 1
    ext.args = '--fast'
    ext.version = '1.0'
    resourceLimits = [cpus: 4, memory: 8.GB]
    withLabel: big_mem {
        memory = 8.GB
    }
    withName: GREET {
        ext.args = '-x'
    }
}

executor {
    name = 'local'
    '$sge' {
        queueSize = 10
    }
}

docker.enabled = true

plugins {
    id 'nf-schema@2.5.1'
}

profiles {
    test {
        params.count = 1
        process.cpus = 2
    }
}

includeConfig 'conf/extra.config'
