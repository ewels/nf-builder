// F-601 (FI-03): option names the catalogue doesn't know; lint is silent, Nextflow warns at run time.
manifest {
    description = 'Greets and shouts'
}

process {
    cpus = 1
    memmory = '4 GB'
    withLabel: big_mem {
        memry = '8 GB'
    }
}

docker.enable = true

profiles {
    test {
        process.cpuss = 2
    }
}

includeConfig 'conf/extra.config'
