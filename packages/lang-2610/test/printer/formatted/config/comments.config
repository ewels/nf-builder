// F-601 (ADR 0032): comments in every position.

/* a block comment
 * over two lines
 */
manifest {
    // before name
    name = 'x' // trailing name

    // dangling in manifest
}

// before process
process {
    cpus = 1 // trailing cpus
    /* before memory */
    memory = 2.GB

    withLabel: big_mem {
        // only a comment
    }
} // trailing process

// at the end
