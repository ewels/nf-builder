// F-601 (ADR 0032): blocks, dotted assignments and nesting, written untidily.
manifest {
    name = 'nf-core/demo'
    description = "A demo"
    nextflowVersion = '>=26.10.6'
}


docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

executor {
    name = 'slurm'
    queueSize = 100
    retry {
        delay = 500.ms
    }
    retry.maxAttempt = 5
}

empty {
}

'odd-name' {
    x = 1
}
workDir = 'work'
