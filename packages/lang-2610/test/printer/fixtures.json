      "printed": "printed-ast"
    }
  ],
  "knownDifferences": {
    "type-rename": "lint -format renames resolved types through the Java class hierarchy (int to Integer, ArrayList to List, Long to Integer); the result can fail lint or change what the code does. The printer prints type names as written.",
    "catch-package": "lint -format drops the package of every catch type, so java.nio.file.AccessDeniedException becomes an undefined AccessDeniedException. The printer drops it only for default-imported packages.",
    "call-wrap": "lint -format prints f(1)(2) as a wrapped .call( and wraps again on every pass. The printer prints f(1).call(2) and wraps only for a trailing comma, comments or arguments on a later line.",
    "named-args-comma": "lint -format writes the comma between the positional and the named arguments of a wrapped call after the trailing comma and the trailing comment of the last positional argument, so it prints a,, or a // c, (invalid code). The printer writes the comma with the argument.",
    "directive-comment": "lint -format prints the arguments of a directive wrapped by a comment without parentheses (memory, the comment, 2.GB), which is not a directive any more. The printer keeps the parentheses and wraps them as it wraps call arguments.",
    "string-reindent": "lint -format shifts the interior lines of a multi-line string with the statement that holds it, which changes the string's value (docs/research/upstream-bugs.md #23). The printer prints multi-line string and GString content exactly as written."
  },
