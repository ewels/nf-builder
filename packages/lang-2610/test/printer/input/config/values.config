// F-601 (ADR 0032): the value forms the forms write.
process {
    memory = 8.GB
    time = 2.h
    cpus = 4
    queue = 'it\'s $HOME'
    container = "ubuntu:${params.tag}"
    ext.list = ['conda-forge','bioconda']
    ext.map = [cpus:4,memory:8.GB]
    ext.flag = true
    ext.neg = -1
    ext.ratio = 0.5
    ext.closure = { task.attempt * 2.GB }
    ext.tern = params.big ? 8.GB : 2.GB
}
params.ratio = 1.5
params.loud = false
env.GREETING_STYLE = 'loud'
cleanup = true
