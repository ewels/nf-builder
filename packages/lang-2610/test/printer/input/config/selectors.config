// F-601 (ADR 0032): process defaults, selectors and resource limits.
process {
  cpus = 1
  memory = 2.GB
  time=1.h
  resourceLimits = [cpus:16, memory: 128.GB, time: 48.h]
    withLabel: big_mem { memory = 8.GB }
  withName:'GREET|SHOUT' {
    cpus = 2
    ext.args = '--fast'
  }
  withName: 'GREETING:GREET' {
        errorStrategy = 'retry'
  }
  withLabel:'!big_mem' {
    maxRetries = 3
  }
}
