{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!.claude/skills",
      "!packages/lang-*/src/generated",
      "!packages/lang-*/catalogue",
      "!packages/lang-*/palette.json",
      "!tools/registry-snapshot/test/fixtures/recorded",
      "!tools/registry-snapshot/test/fixtures/expected"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "json": {
    "formatter": {
      "expand": "always"
    }
  }
}
